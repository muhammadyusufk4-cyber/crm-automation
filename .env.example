# Public site URL used for SEO metadata, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=https://www.converge.ai

# Calendly scheduling link embedded on /contact. Leave unset to show a placeholder.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-team/strategy-call

# Webhook URL the contact form forwards leads to (e.g. a CRM's inbound webhook,
# a Zapier/Make catch hook, or an n8n endpoint). Leave unset to log submissions
# to the server console instead.
CRM_WEBHOOK_URL=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
